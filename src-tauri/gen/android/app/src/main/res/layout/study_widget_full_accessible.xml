<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_shape_28" android:clipToOutline="true" android:padding="16dp">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_marigold_onsurface" android:text="" android:layout_weight="1" android:textStyle="bold" android:letterSpacing=".08" android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/widget_deck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Deck" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Deck" />
    </LinearLayout>
    <TextView android:id="@+id/widget_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_marigold_onsurface" android:text="" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/widget_marigold_onsurface" android:text="" android:textStyle="bold" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:id="@+id/widget_content">
        <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/widget_marigold_onsurface" android:text="" android:gravity="top" android:padding="8dp" />
        <TextView android:id="@+id/widget_recall" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_marigold_onsurface" android:text="How well did you recall it?" android:layout_marginTop="8dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_parts" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="‹" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="‹" />
        <TextView android:id="@+id/widget_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_marigold_onsurface" android:text="" />
        <Button android:id="@+id/widget_next_part" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="›" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="›" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_review" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/widget_again" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Again" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Again" />
            <Button android:id="@+id/widget_hard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Hard" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Hard" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/widget_good" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Good" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Good" />
            <Button android:id="@+id/widget_easy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Easy" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Easy" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/widget_reveal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Reveal answer" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Reveal answer" />
        <Button android:id="@+id/widget_voice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="🎙︎" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="♩" />
        <Button android:id="@+id/widget_skip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="6dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_shape_pill" android:text="Next" android:textAllCaps="false" android:textSize="12sp" android:contentDescription="Next" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/widget_marigold_onsurface" android:text="" />
</LinearLayout>