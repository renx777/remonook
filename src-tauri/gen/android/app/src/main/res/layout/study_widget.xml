<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/study_widget_background" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RemoNook · Study" android:textSize="12sp" android:textColor="@color/study_widget_accent" android:textStyle="bold"/>
        <Button android:padding="0dp" android:id="@+id/widget_deck" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="0dp" android:minWidth="48dp" android:background="@drawable/study_widget_button" android:text="Deck" android:textSize="12sp" android:textAllCaps="false" android:textColor="@color/study_widget_text"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="@color/study_widget_muted" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/study_widget_accent"/>
    <TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:textSize="16sp" android:textColor="@color/study_widget_text" android:gravity="center_vertical"/>
    <LinearLayout android:id="@+id/widget_parts" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <Button android:padding="0dp" android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="36dp" android:background="@drawable/study_widget_button" android:minHeight="0dp" android:text="‹" android:textColor="@color/study_widget_text" android:contentDescription="Previous text part"/>
        <TextView android:id="@+id/widget_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/study_widget_muted" android:textSize="11sp"/>
        <Button android:padding="0dp" android:id="@+id/widget_next_part" android:layout_width="48dp" android:layout_height="36dp" android:background="@drawable/study_widget_button" android:minHeight="0dp" android:text="›" android:textColor="@color/study_widget_text" android:contentDescription="Next text part"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_review" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="5dp">
        <Button android:padding="0dp" android:id="@+id/widget_again" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:background="@drawable/study_widget_button" android:text="Again" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text" android:contentDescription="Grade Again"/>
        <Button android:padding="0dp" android:id="@+id/widget_hard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="3dp" android:background="@drawable/study_widget_button" android:text="Hard" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text" android:contentDescription="Grade Hard"/>
        <Button android:padding="0dp" android:id="@+id/widget_good" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="3dp" android:background="@drawable/study_widget_button" android:text="Good" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text" android:contentDescription="Grade Good"/>
        <Button android:padding="0dp" android:id="@+id/widget_easy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="3dp" android:background="@drawable/study_widget_button" android:text="Easy" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text" android:contentDescription="Grade Easy"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="5dp">
        <Button android:padding="0dp" android:id="@+id/widget_reveal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/study_widget_button" android:text="Reveal answer" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text"/>
        <Button android:padding="0dp" android:id="@+id/widget_skip" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="48dp" android:background="@drawable/study_widget_button" android:text="Next" android:textAllCaps="false" android:textSize="12sp" android:textColor="@color/study_widget_text" android:contentDescription="Next card without grading"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="10sp" android:textColor="@color/study_widget_muted"/>
</LinearLayout>
