{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoNook",
  "version": "0.1.0",
  "identifier": "com.remonook.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoNook",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Notes, outlines and flashcards",
    "longDescription": "RemoNook: an outliner for notes, flashcards and study, synced across your devices.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBMTZGQTE4NTZCNDFFNUIKUldSYkhyUldHUG9XNm1uZHBvdVR3SUZIdjRlV25nbkpwZlptY1ByZEY4amFRS2RzNWRkYmU4akkK",
      "endpoints": [
        "https://remo-sync.remo-978fb.workers.dev/desktop/production/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
