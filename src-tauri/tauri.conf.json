{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoNook",
  "version": "0.1.0",
  "identifier": "com.remonook.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RemoNook",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Notes, outlines and flashcards",
    "longDescription": "RemoNook: an outliner for notes, flashcards and study, synced across your devices.",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
