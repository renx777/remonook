{
  "name": "remo-sync",
  "main": "worker.mjs",
  "account_id": "e9a5c70b0fbe2e2d493fc21de0bbb40f",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remo-sync",
      "database_id": "1cb5f16d-ea54-4177-879a-fbaa3bab02b0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "remo-attachments"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "remo-978fb",
    "ALLOWED_ORIGINS": "https://remonook.com,https://remo-notes.arenukaprasad.chatgpt.site",
    "BOOK_UPLOADS_ENABLED": "true",
    "GOOGLE_TASKS_REDIRECT_URI": "https://remo-sync.remo-978fb.workers.dev/integrations/google-tasks/callback"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 30000
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_SPACE",
        "class_name": "SyncSpace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sync-space",
      "new_sqlite_classes": [
        "SyncSpace"
      ]
    }
  ]
}
