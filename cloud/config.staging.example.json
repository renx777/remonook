{
  "name": "remo-sync-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "remonook-staging",
    "ALLOWED_ORIGINS": "https://staging.remonook.com",
    "GOOGLE_TASKS_REDIRECT_URI": "https://remo-sync-staging.remo-978fb.workers.dev/integrations/google-tasks/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remo-sync-staging",
      "database_id": "8343200b-cb13-4d6a-a165-d6881873e306"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "remo-attachments-staging"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
