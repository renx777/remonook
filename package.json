{
  "name": "remo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-reader-assets.mjs && node scripts/build-offline.mjs",
    "test": "node scripts/prepare-tests.mjs && node --test --test-concurrency=2 tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "build:staging": "node scripts/build-environment.mjs staging",
    "build:production": "node scripts/build-environment.mjs production"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react-dom": "2.1.9",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "2.1.10",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "canvas-confetti": "^1.9.4",
    "diff": "8.0.2",
    "fast-xml-parser": "5.11.2",
    "firebase": "^13.1.0",
    "highlight.js": "^11.12.0",
    "html-entities": "2.6.0",
    "jose": "^6.2.13",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "1.61.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "motion": "^14.7.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "2.3.0",
    "rough-notation": "0.5.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "gifenc": "^1.0.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
