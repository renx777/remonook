{
  "name": "remo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "test": "node scripts/prepare-tests.mjs && node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "build:staging": "node scripts/build-environment.mjs staging",
    "build:production": "node scripts/build-environment.mjs production"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "firebase": "^13.1.0",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.13",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lottie-web": "^5.13.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.0.0",
    "gifenc": "^1.0.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
